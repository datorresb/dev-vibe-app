# Azure OpenAI Configuration for local Docker development
# Authentication: Uses mounted ~/.azure credentials from az login

# Azure OpenAI endpoint URL
AZURE_OPENAI_ENDPOINT=https://davidto-devagents-resource.openai.azure.com/

# Deployment name for chat completions
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.1-chat

# API version
AZURE_OPENAI_API_VERSION=2024-12-01-preview
