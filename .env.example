# Azure OpenAI Configuration
# Authentication: Managed Identity (MSI) - No API Key required
# For local dev, run `az login` first

# Required: Azure OpenAI endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Required: API version
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Required: Chat model deployment name
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.1-chat

# Required: Embedding model deployment name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure Managed Identity (optional - auto-detected in Azure)
# Only needed if using specific identity
AZURE_TENANT_NAME=
AZURE_TENANT_ID=

SUBSCRIPTION_NAME=
SUBSCRIPTION_ID=